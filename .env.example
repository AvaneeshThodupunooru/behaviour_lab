# Behavior Lab - runtime configuration
#
# Copy this file to `.env` in this same folder and fill in the real values.
# The backend loads `.env` automatically on startup (python-dotenv).
# Never commit the real `.env` - it is git-ignored on purpose.
#
# If MONGODB_URI is missing/empty/unreachable, the backend still starts and
# falls back to the in-memory store (results are lost on restart).
# The database used is `the-thing`; its collections and indexes are created
# automatically on first connect.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
