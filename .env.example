# Behavior Lab — example environment configuration
#
# IMPORTANT: The backend reads settings from the PROCESS ENVIRONMENT,
# not from this file. This file exists purely as documentation of the
# variables you may need to set before starting the server.
#
# On Windows (PowerShell):
#   $env:MONGODB_URI = "mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority"
#
# On Windows (CMD):
#   set MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
#
# Never put a real URI/password in any committed file.

# MongoDB Atlas connection string.
# - Omit it entirely to run with the in-memory MemoryStore (results are lost
#   when the server restarts).
# - The database used is named `the-thing`; collections (`sessions`,
#   `counters`) and indexes are created automatically on first connect.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER-HOST.mongodb.net/?retryWrites=true&w=majority
